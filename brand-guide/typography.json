{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Typography System",
  "description": "Defines all typography settings including fonts, sizes, and scales",
  "fontFamilies": {
    "heading": {
      "name": "Inter",
      "fallback": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
      "weights": [400, 500, 600, 700, 800],
      "googleFonts": "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
    },
    "body": {
      "name": "Inter",
      "fallback": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
      "weights": [400, 500, 600],
      "googleFonts": "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap"
    },
    "mono": {
      "name": "JetBrains Mono",
      "fallback": "Monaco, Courier, monospace",
      "weights": [400, 500],
      "googleFonts": "https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap"
    }
  },
  "fontSize": {
    "xs": {
      "size": "0.75rem",
      "lineHeight": "1rem",
      "px": "12px"
    },
    "sm": {
      "size": "0.875rem",
      "lineHeight": "1.25rem",
      "px": "14px"
    },
    "base": {
      "size": "1rem",
      "lineHeight": "1.5rem",
      "px": "16px"
    },
    "lg": {
      "size": "1.125rem",
      "lineHeight": "1.75rem",
      "px": "18px"
    },
    "xl": {
      "size": "1.25rem",
      "lineHeight": "1.75rem",
      "px": "20px"
    },
    "2xl": {
      "size": "1.5rem",
      "lineHeight": "2rem",
      "px": "24px"
    },
    "3xl": {
      "size": "1.875rem",
      "lineHeight": "2.25rem",
      "px": "30px"
    },
    "4xl": {
      "size": "2.25rem",
      "lineHeight": "2.5rem",
      "px": "36px"
    },
    "5xl": {
      "size": "3rem",
      "lineHeight": "1",
      "px": "48px"
    },
    "6xl": {
      "size": "3.75rem",
      "lineHeight": "1",
      "px": "60px"
    },
    "7xl": {
      "size": "4.5rem",
      "lineHeight": "1",
      "px": "72px"
    }
  },
  "fontWeight": {
    "normal": 400,
    "medium": 500,
    "semibold": 600,
    "bold": 700,
    "extrabold": 800
  },
  "headings": {
    "h1": {
      "fontSize": "4xl",
      "fontWeight": "bold",
      "lineHeight": "1.2",
      "marginBottom": "1.5rem",
      "responsive": {
        "mobile": "3xl",
        "tablet": "4xl",
        "desktop": "5xl"
      }
    },
    "h2": {
      "fontSize": "3xl",
      "fontWeight": "bold",
      "lineHeight": "1.3",
      "marginBottom": "1.25rem",
      "responsive": {
        "mobile": "2xl",
        "tablet": "3xl",
        "desktop": "4xl"
      }
    },
    "h3": {
      "fontSize": "2xl",
      "fontWeight": "semibold",
      "lineHeight": "1.4",
      "marginBottom": "1rem",
      "responsive": {
        "mobile": "xl",
        "tablet": "2xl",
        "desktop": "3xl"
      }
    },
    "h4": {
      "fontSize": "xl",
      "fontWeight": "semibold",
      "lineHeight": "1.5",
      "marginBottom": "0.875rem"
    },
    "h5": {
      "fontSize": "lg",
      "fontWeight": "medium",
      "lineHeight": "1.5",
      "marginBottom": "0.75rem"
    },
    "h6": {
      "fontSize": "base",
      "fontWeight": "medium",
      "lineHeight": "1.5",
      "marginBottom": "0.5rem"
    }
  },
  "body": {
    "fontSize": "base",
    "lineHeight": "1.75",
    "fontWeight": "normal"
  },
  "notes": {
    "usage": "Use heading font for all headings and hero text, body font for paragraphs",
    "accessibility": "Maintain minimum 16px base font size for readability",
    "customization": "Replace Inter with client's brand fonts if available"
  }
}
