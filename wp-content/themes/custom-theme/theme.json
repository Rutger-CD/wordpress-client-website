{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "1024px",
      "wideSize": "1280px"
    },
    "color": {
      "palette": [
        {
          "slug": "primary",
          "color": "#0ea5e9",
          "name": "Primary"
        },
        {
          "slug": "primary-dark",
          "color": "#0284c7",
          "name": "Primary Dark"
        },
        {
          "slug": "secondary",
          "color": "#a855f7",
          "name": "Secondary"
        },
        {
          "slug": "text-primary",
          "color": "#171717",
          "name": "Text Primary"
        },
        {
          "slug": "text-secondary",
          "color": "#525252",
          "name": "Text Secondary"
        },
        {
          "slug": "background",
          "color": "#ffffff",
          "name": "Background"
        },
        {
          "slug": "background-secondary",
          "color": "#f5f5f5",
          "name": "Background Secondary"
        },
        {
          "slug": "success",
          "color": "#10b981",
          "name": "Success"
        },
        {
          "slug": "warning",
          "color": "#f59e0b",
          "name": "Warning"
        },
        {
          "slug": "error",
          "color": "#ef4444",
          "name": "Error"
        }
      ],
      "gradients": [
        {
          "slug": "primary-gradient",
          "gradient": "linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%)",
          "name": "Primary Gradient"
        },
        {
          "slug": "secondary-gradient",
          "gradient": "linear-gradient(135deg, #a855f7 0%, #9333ea 100%)",
          "name": "Secondary Gradient"
        }
      ],
      "duotone": [],
      "custom": true,
      "customDuotone": true,
      "customGradient": true,
      "defaultGradients": false,
      "defaultPalette": false
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
          "slug": "heading",
          "name": "Heading Font"
        },
        {
          "fontFamily": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
          "slug": "body",
          "name": "Body Font"
        },
        {
          "fontFamily": "'JetBrains Mono', Monaco, Courier, monospace",
          "slug": "mono",
          "name": "Monospace"
        }
      ],
      "fontSizes": [
        {
          "slug": "xs",
          "size": "0.75rem",
          "name": "Extra Small"
        },
        {
          "slug": "sm",
          "size": "0.875rem",
          "name": "Small"
        },
        {
          "slug": "base",
          "size": "1rem",
          "name": "Base"
        },
        {
          "slug": "lg",
          "size": "1.125rem",
          "name": "Large"
        },
        {
          "slug": "xl",
          "size": "1.25rem",
          "name": "Extra Large"
        },
        {
          "slug": "2xl",
          "size": "1.5rem",
          "name": "2X Large"
        },
        {
          "slug": "3xl",
          "size": "1.875rem",
          "name": "3X Large"
        },
        {
          "slug": "4xl",
          "size": "2.25rem",
          "name": "4X Large"
        },
        {
          "slug": "5xl",
          "size": "3rem",
          "name": "5X Large"
        }
      ],
      "fontWeight": true,
      "lineHeight": true,
      "customFontSize": true,
      "dropCap": false
    },
    "spacing": {
      "padding": true,
      "margin": true,
      "units": ["px", "rem", "em", "%", "vh", "vw"],
      "spacingSizes": [
        {
          "slug": "xs",
          "size": "0.5rem",
          "name": "Extra Small"
        },
        {
          "slug": "sm",
          "size": "1rem",
          "name": "Small"
        },
        {
          "slug": "md",
          "size": "1.5rem",
          "name": "Medium"
        },
        {
          "slug": "lg",
          "size": "2rem",
          "name": "Large"
        },
        {
          "slug": "xl",
          "size": "3rem",
          "name": "Extra Large"
        },
        {
          "slug": "2xl",
          "size": "4rem",
          "name": "2X Large"
        },
        {
          "slug": "3xl",
          "size": "6rem",
          "name": "3X Large"
        }
      ]
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "custom": {
      "spacing": {
        "section": {
          "mobile": "3rem",
          "tablet": "4rem",
          "desktop": "6rem"
        },
        "container": {
          "mobile": "1rem",
          "tablet": "2rem",
          "desktop": "3rem"
        }
      },
      "borderRadius": {
        "sm": "0.125rem",
        "base": "0.25rem",
        "md": "0.375rem",
        "lg": "0.5rem",
        "xl": "0.75rem",
        "2xl": "1rem",
        "full": "9999px"
      },
      "shadow": {
        "sm": "0 1px 2px 0 rgb(0 0 0 / 0.05)",
        "base": "0 1px 3px 0 rgb(0 0 0 / 0.1)",
        "md": "0 4px 6px -1px rgb(0 0 0 / 0.1)",
        "lg": "0 10px 15px -3px rgb(0 0 0 / 0.1)",
        "xl": "0 20px 25px -5px rgb(0 0 0 / 0.1)"
      }
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--background)",
      "text": "var(--wp--preset--color--text-primary)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--base)",
      "lineHeight": "1.75",
      "fontWeight": "400"
    },
    "spacing": {
      "padding": {
        "top": "0",
        "right": "var(--wp--custom--spacing--container--mobile)",
        "bottom": "0",
        "left": "var(--wp--custom--spacing--container--mobile)"
      }
    },
    "elements": {
      "h1": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontSize": "var(--wp--preset--font-size--5-xl)",
          "fontWeight": "700",
          "lineHeight": "1.2"
        },
        "spacing": {
          "margin": {
            "bottom": "1.5rem"
          }
        }
      },
      "h2": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontSize": "var(--wp--preset--font-size--4-xl)",
          "fontWeight": "700",
          "lineHeight": "1.3"
        },
        "spacing": {
          "margin": {
            "bottom": "1.25rem"
          }
        }
      },
      "h3": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontSize": "var(--wp--preset--font-size--3-xl)",
          "fontWeight": "600",
          "lineHeight": "1.4"
        },
        "spacing": {
          "margin": {
            "bottom": "1rem"
          }
        }
      },
      "h4": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontSize": "var(--wp--preset--font-size--2-xl)",
          "fontWeight": "600",
          "lineHeight": "1.5"
        }
      },
      "h5": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontSize": "var(--wp--preset--font-size--xl)",
          "fontWeight": "500",
          "lineHeight": "1.5"
        }
      },
      "h6": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontSize": "var(--wp--preset--font-size--lg)",
          "fontWeight": "500",
          "lineHeight": "1.5"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--primary)"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--primary-dark)"
          }
        },
        ":focus": {
          "outline": {
            "width": "2px",
            "style": "solid",
            "color": "var(--wp--preset--color--primary)",
            "offset": "2px"
          }
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "var(--wp--preset--color--background)"
        },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--base)",
          "fontWeight": "500"
        },
        "spacing": {
          "padding": {
            "top": "0.75rem",
            "right": "1.5rem",
            "bottom": "0.75rem",
            "left": "1.5rem"
          }
        },
        "border": {
          "radius": "var(--wp--custom--border-radius--lg)"
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--primary-dark)"
          }
        }
      }
    },
    "blocks": {
      "core/paragraph": {
        "spacing": {
          "margin": {
            "bottom": "1rem"
          }
        }
      },
      "core/group": {
        "spacing": {
          "padding": {
            "top": "var(--wp--custom--spacing--section--mobile)",
            "bottom": "var(--wp--custom--spacing--section--mobile)"
          }
        }
      },
      "core/columns": {
        "spacing": {
          "margin": {
            "bottom": "2rem"
          }
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "blank",
      "title": "Blank",
      "postTypes": ["page", "post"]
    },
    {
      "name": "page-no-title",
      "title": "Page (No Title)",
      "postTypes": ["page"]
    }
  ]
}
