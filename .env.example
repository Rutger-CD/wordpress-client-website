# Linear API Configuration
# Get your API key from: https://linear.app/settings/api
LINEAR_API_KEY=lin_api_your_key_here

# GitHub Configuration (if needed for deployment)
GITHUB_TOKEN=your_github_token_here

# Strato Hosting - Staging Environment
STAGING_SFTP_HOST=ssh.strato.com
STAGING_SFTP_PORT=22
STAGING_SFTP_USER=your_sftp_user
STAGING_SFTP_PASSWORD=your_sftp_password
STAGING_PATH=/wp-base-stg
STAGING_URL=https://wp-base-stg.rutgerthus.nl

STAGING_DB_HOST=your_database_host
STAGING_DB_NAME=your_database_name
STAGING_DB_USER=your_database_user
STAGING_DB_PASSWORD=your_database_password

# Strato Hosting - Production Environment
PRODUCTION_SFTP_HOST=ssh.strato.com
PRODUCTION_SFTP_PORT=22
PRODUCTION_SFTP_USER=your_sftp_user
PRODUCTION_SFTP_PASSWORD=your_sftp_password
PRODUCTION_PATH=/wp-base
PRODUCTION_URL=https://wp-base.rutgerthus.nl

PRODUCTION_DB_HOST=your_database_host
PRODUCTION_DB_NAME=your_database_name
PRODUCTION_DB_USER=your_database_user
PRODUCTION_DB_PASSWORD=your_database_password
